-- ============================================
-- LÓGICA DO AUTO CLICKER
-- ============================================
local ativo = false
local rodando = false

-- Função: clicar em ClickDetectors próximos
local function clicarDetectors()
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end

	local posJogador = char.HumanoidRootPart.Position
	local clicou = false

	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("ClickDetector") then
			local parent = obj.Parent
			if parent and parent:IsA("BasePart") then
				local dist = (parent.Position - posJogador).Magnitude
				if dist <= CONFIG.RaioClickDetector then
					pcall(function()
						fireclickdetector(obj)
					end)
					clicou = true
				end
			end
		end
	end

	return clicou
end

-- Função: simular clique de mouse
local function clicarMouse()
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(
			CONFIG.PosicaoMouseX,
			CONFIG.PosicaoMouseY,
			0, true, game, 1
		)
		task.wait(0.02)
		VirtualInputManager:SendMouseButtonEvent(
			CONFIG.PosicaoMouseX,
			CONFIG.PosicaoMouseY,
			0, false, game, 1
		)
	end)
end

-- Loop principal
local function loopClique()
	if rodando then return end
	rodando = true

	task.spawn(function()
		while ativo do
			if CONFIG.ModoClickDetector then
				clicarDetectors()
			end

			if CONFIG.ModoGUIMouse then
				clicarMouse()
			end

			task.wait(CONFIG.IntervaloClique)
		end
		rodando = false
	end)
end

-- ============================================
-- EVENTOS DOS BOTÕES
-- ============================================
button.Activated:Connect(function()
	ativo = not ativo
	button.Text = ativo and "AUTO CLICK: ON" or "AUTO CLICK: OFF"
	button.BackgroundColor3 = ativo 
		and Color3.fromRGB(50, 180, 50) 
		or Color3.fromRGB(180, 50, 50)

	if ativo then
		loopClique()
	end
end)

btnDetector.Activated:Connect(function()
	CONFIG.ModoClickDetector = not CONFIG.ModoClickDetector
